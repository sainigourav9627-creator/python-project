Concepts: Functions + Parameters + Function Calling + if/elif/else + while + break

def add(a, b):
    print("Addition =", a + b)

def subtract(a, b):
    print("Subtraction =", a - b)

def multiply(a, b):
    print("Multiplication =", a * b)

def divide(a, b):
    print("Division =", a / b)

